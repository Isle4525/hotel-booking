# ==========================================
# Настройки сред разработки (IDE) и ОС Linux
# ==========================================

# GoLand и другие продукты JetBrains
.idea/
*.iwb
*.iml
*.iws

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
*.code-workspace

# Системные файлы Linux
*~
.directory
.Trash-*/

# Бинарные файлы и скомпилированные плагины
*.exe
*.exe~
*.dll
*.so
*.dylib

# Тестовые бинарники, создаваемые при запуске go test -c
*.test

# Файлы отчетов о покрытии кода тестами и профилирования
*.out
*.prof
*.coverprofile
profile.cov

# Локальные файлы рабочего пространства Go (Go modules workspace)
go.work
go.work.sum

# Файлы окружения (содержат секреты и локальные настройки)
.env
.envrc

# Временные файлы и папки сборки (если вы собираете проект в bin/)
bin/
dist/

# Раскомментируйте строку ниже, если вы НЕ хотите сохранять локальные копии зависимостей
# vendor/

